{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lingviora-words-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lingviora-words-production",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "APP_BASE_URL": "https://words.example.com",
    "ALLOWED_ORIGINS": "https://words.example.com",
    "COOKIE_SAME_SITE": "lax",
    "TURNSTILE_SITE_KEY": "replace-with-cloudflare-turnstile-site-key",
    "TURNSTILE_EXPECTED_HOSTNAMES": "words.example.com",
    "EMAIL_FROM": "Lingviora Words <no-reply@account.example.com>",
    "EMAIL_REPLY_TO": "support@example.com",
    "ALLOW_TEST_MAILBOX": "false"
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY", "RESEND_API_KEY"]
  }
}
